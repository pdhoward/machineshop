# Machine Shop: every key the site needs. Values never go in the repo.
# (The Accelerator reads this file to build the site's Configuration page.)

# Product catalog (MongoDB, read-only). Where: MongoDB Atlas → Database → Connect → Drivers.
MONGODB_URI=
# Database and collection names. Defaults: openai / product.
MONGODB_DB=openai
MONGODB_COLLECTION=product

# Shop assistant (optional; the site works without it). Where: console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace. Where: console.anthropic.com → Settings → Workspaces.
ANTHROPIC_WORKSPACE_ID=
# Which Claude model the assistant uses. Default: claude-sonnet-5.
ASSISTANT_MODEL=

# Talk mode (live voice, optional). OpenAI is used for voice only; typed chat stays on Claude.
# Server-only key; the browser only ever gets a one-call pass. Use a project key with a monthly spending limit.
# Where: platform.openai.com → Settings → Project → API keys (set the limit under Settings → Limits).
OPENAI_API_KEY=
# OpenAI realtime voice model for Talk mode. Where: platform.openai.com → Docs → Models (realtime), e.g. gpt-realtime.
VOICE_MODEL=
# Code shoppers enter before each call. Five wrong codes lock the caller out for an hour.
# Where: choose it yourself and share it with the people you invite to try Talk.
VOICE_ACCESS_CODE=
# Owner code for the private saved-calls list at /owner/transcripts. Wrong codes count toward the same lockout.
# Where: choose it yourself (different from VOICE_ACCESS_CODE) and keep it to the site owner. Changing it signs the owner out.
VOICE_OWNER_CODE=

# Buy now (Stripe Checkout, optional; without it no "Buy now" button shows). TEST MODE ONLY:
# the server refuses any key that does not start with sk_test_ (or rk_test_). Stripe keeps the orders and addresses.
# Where: dashboard.stripe.com → turn on Test mode → Developers → API keys → Secret key (sk_test_...).
STRIPE_SECRET_KEY=

# Talk mode's own database (MongoDB) for call sessions, wrong-code attempts and 30-day transcripts.
# Must be a separate database with its own login that can write only there, never the catalog's MONGODB_URI.
# Where: MongoDB Atlas → Database Access → add a user with readWrite on the voice database only, then Database → Connect → Drivers.
VOICE_MONGODB_URI=
# Name of that voice database. Where: the database you granted the voice user readWrite on (e.g. machineshop_voice).
VOICE_MONGODB_DB=
# Long random string that signs voice session tokens and scrambles stored device and network IDs.
# Where: generate it yourself, e.g. `openssl rand -hex 32`; use a different value per environment.
VOICE_SECRET=

#===================================
# STRIPE TEST ACCESS
#==================================
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

