# Machine Shop: every key the site needs. Values never go in the repo.
# (The Accelerator reads this file to build the site's Configuration page.)

# Product catalog (MongoDB, read-only). Where: MongoDB Atlas → Database → Connect → Drivers.
MONGODB_URI=
# Database and collection names. Defaults: openai / product.
MONGODB_DB=openai
MONGODB_COLLECTION=product

# Shop assistant (optional; the site works without it). Where: console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace. Where: console.anthropic.com → Settings → Workspaces.
ANTHROPIC_WORKSPACE_ID=
# Which Claude model the assistant uses. Default: claude-sonnet-5.
ASSISTANT_MODEL=
